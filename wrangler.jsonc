{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "kikko",
	"compatibility_date": "2026-03-07",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "kikko"
		}
	],
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying
			// You can change the bucket name if you want
			// See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
			"bucket_name": "kikko-opennext-cache"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// 正規ドメインは worxmtfuji.com。それ以外（www・綴り違いの worksmtfuji.com）は next.config.ts でリダイレクト
	"routes": [
		{ "pattern": "worxmtfuji.com", "custom_domain": true },
		{ "pattern": "www.worxmtfuji.com", "custom_domain": true },
		{ "pattern": "worksmtfuji.com", "custom_domain": true },
		{ "pattern": "www.worksmtfuji.com", "custom_domain": true }
	],
	// 秘密でない値のみ。RESEND_API_KEY は `wrangler secret put` で設定する
	"vars": {
		"RESEND_FROM": "橘香堂 <noreply@worxmtfuji.com>"
	}
}